import paho.mqtt.client as mqtt  # MQTT 통신을 위한 라이브러리 임포트
import time                      # 시간 지연(sleep) 기능을 사용하기 위한 모듈
from gpiozero import LED         # 라즈베리 파이 GPIO 제어를 위한 LED 클래스 임포트
import threading                 # 메시지 수신과 발행을 동시에 처리하기 위한 스레드 모듈

# GPIO 및 LED 설정
greenLed = LED(16)  # 16번 핀에 연결된 초록색 LED 객체 생성
blueLed = LED(20)   # GPIO 20번 핀에 연결된 파란색 LED 객체 생성
redLed = LED(21)    # GPIO 21번 핀에 연결된 빨간색 LED 객체 생성

# MQTT 콜백 함수 정의

def on_message(client, userdata, msg): # 브로커로부터 메시지를 받았을 때(Subscribed) 자동으로 호출되는 함수
    print(msg.topic + " " + str(msg.payload))   # 수신된 토픽명과 페이로드(데이터)를 출력
    
    message = msg.payload.decode()   # 수신된 바이트 데이터를 문자열로 변환 (예: b'green_on' -> 'green_on')
    print(message)

    # 메시지 내용에 따라 해당 LED 제어
    if message == "green_on":  # 수신된 메시지가 초록일 때
        greenLed.on()
    elif message == "green_off":
        greenLed.off()
    elif message == "blue_on":
        blueLed.on()
    elif message == "blue_off":
        blueLed.off()
    elif message == "red_on":
        redLed.on()
    elif message == "red_off":
        redLed.off()

#  MQTT 클라이언트 설정 
client = mqtt.Client()              # MQTT 클라이언트 객체 생성
client.on_message = on_message      # 메시지 도착 시 실행할 콜백 함수 등록

# MQTT 브로커(서버) 연결 설정
broker_address = "192.168.137.230"  # 브로커 역할을 하는 라즈베리 파이의 IP 주소
client.connect(broker_address)      # 설정된 IP의 브로커에 접속
client.subscribe("led", 1)          # "led" 토픽을 구독 (QoS 레벨 1 설정)

# 별도 스레드용 함수 (메시지 발행) 
count = 0
def send_thread():
    global count
    while True:                     # 무한 루프
        count = count + 1           # 카운트 1씩 증가
        # "hello" 토픽으로 현재 카운트 값을 문자열로 전송(Publish)
        client.publish("hello", str(count))
        time.sleep(1.0)             # 1초 대기

# 메인 실행부 
# 숫자를 발행하는 함수(send_thread)를 백그라운드 스레드로 시작
task = threading.Thread(target=send_thread)
task.start()

# 메시지 수신을 위해 무한 루프 실행 (프로그램이 종료되지 않게 유지)
client.loop_forever()
