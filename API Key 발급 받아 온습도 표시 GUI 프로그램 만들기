import urllib.request                  # 웹 URL을 통해 데이터를 요청하는 라이브러리
import json                            # JSON 데이터 처리 라이브러리
import tkinter                         # GUI 창 만드는 라이브러리
import tkinter.font                    # tkinter 폰트 설정 라이브러리
API_KEY = "Enter your API key here"    # OpenWeatherMap에서 발급받은 API 키 입력 필요

def tick1Min():
    url = f"https://api.openweathermap.org/data/2.5/weather?q=Seoul&appid={API_KEY}&units=metric"      # 서울 날씨 요청 URL
    with urllib.request.urlopen(url) as r:             # API에 요청 보내기
          data = json.loads(r.read())                  # 바이트 형태의 응답을 JSON(딕셔너리)으로 변환
    temp = data["main"]["temp"]                        # 데이터 중 현재 기온(temp) 추출
    humi = data["main"]["humidity"]                    # 데이터 중 현재 습도(humidity) 추출
    label.config(text=f"{temp:.1f}C {humi}%")          # 추출한 정보를 화면의 라벨(Label)에 업데이트 (소수점 첫째 자리까지 표시)
    window.after(60000, tick1Min)                      # 1분(60000ms) 후 함수 재실행

window = tkinter.Tk()                                  # 메인 윈도우 창 객체 생성
window.title("TEMP HUMI DISPLAY")                      # 창의 상단 제목 설정
window.geometry("400x100")                             # 창의 크기 설정 (가로 400px, 세로 100px)
window.resizable(False, False)                         # 사용자가 창 크기를 임의로 조절하지 못하도록 고정
font = tkinter.font.Font(size=30)                      # 폰트 크기 30 설정
label = tkinter.Label(window, text="", font=font)      # 텍스트를 담을 라벨 생성
label.pack()                                           # 라벨을 화면 중앙에 배치

tick1Min()                                             # 프로그램 실행 즉시 첫 번째 날씨 정보를 가져옴
window.mainloop()                                      # 사용자가 창을 닫기 전까지 이벤트를 계속 처리하며 실행 유지
